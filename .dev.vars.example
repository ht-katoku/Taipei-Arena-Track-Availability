# Copy to .dev.vars for local development. Never commit real values.
# Production and preview values live in Workers secrets only.

# Phase 2 (admin Worker)
ACCESS_AUD=
ACCESS_TEAM_DOMAIN=
CURATOR_EMAILS=
PDF_PARSER_CLIENT_ID=
# Honoured only when ENVIRONMENT=local. CI fails if production config sets it.
ACCESS_DEV_EMAIL=

# Phase 6 (ingest Worker)
CWA_API_KEY=
MOENV_API_KEY=
# Real source hosts are refused in local and preview unless this is 1.
ALLOW_REAL_FETCH=0

# Phase 5 (publish Worker)
CF_PURGE_TOKEN=
CF_ZONE_ID=
